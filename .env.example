# AxiomDesk 环境变量示例
# 复制为 .env 并按需修改（所有变量均以 UZI_ 前缀注入）

# ── 服务 ──
UZI_HOST=127.0.0.1
UZI_PORT=8137
# 开放给局域网/容器时设为 "*" 或具体域名（逗号分隔）
UZI_CORS_ORIGINS=*

# ── 数据层 ──
# demo    = 确定性合成/内置个股（离线，默认）
# akshare = 尝试实时行情，失败自动回退 demo
UZI_DATA_SOURCE=demo
UZI_CACHE_TTL=3600
UZI_CACHE_DIR=.cache

# ── 可观测性 ──
UZI_LOG_LEVEL=INFO
# 生产环境建议 true（结构化 JSON 日志，便于接入 Loki/ELK）
UZI_LOG_JSON=false
# 非空则同时写文件（旋转）：UZI_LOG_FILE=uzi.log
UZI_LOG_FILE=

# ── AI 研判层（DeepSeek）──
# 不配置则自动降级为离线「模板研判」，应用照常运行；配置后由大模型补全
# 维度评语 / 评委洞察 / 多空辩论 / 核心结论 / 风险 / 买入区间。
# DeepSeek 兼容 OpenAI chat/completions 协议，无需额外 SDK。
UZI_DEEPSEEK_API_KEY=
# 默认 https://api.deepseek.com（已含 /v1 路由，无需再拼）
UZI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat（V3，性价比高，默认） / deepseek-reasoner（R1，带推理链）
UZI_DEEPSEEK_MODEL=deepseek-chat
# 单次研判超时（秒）
UZI_DEEPSEEK_TIMEOUT=60

